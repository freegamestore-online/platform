{
  "name": "freegamestore-auth",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/freegamestore-online/auth"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
